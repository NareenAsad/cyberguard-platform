{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "/bin/sh -c \"uvicorn main:app --host 0.0.0.0 --port ${PORT:-8001}\"",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30
  }
}
